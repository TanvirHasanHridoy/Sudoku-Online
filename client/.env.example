# Set this before building the deployed client. Use wss:// for an HTTPS site.
VITE_WS_URL=ws://localhost:3001

# Optional: Connect to your live Supabase project.
# If these variables are not supplied, the application will automatically 
# fall back to a rich, offline-friendly Local Database Simulator!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
